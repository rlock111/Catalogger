extends layout

block content
  .row.banner.mt-4.mb-4
    .col-12.col-md-8.offset-md-2
      a.btn.btn-primary.btn-green.logout-button.float-end(href="/login") Logout
      h1
        i.fa-solid.fa-record-vinyl.record-icon
        | &nbsp;#{title}
  .row
    .col-12.col-md-8.offset-md-2
      each album in albums
        each review in album.reviews

          .card.text-bg-dark.review-card.mb-3
            .card-body
              .row
                .col-4
                  img.img-fluid.rounded(src=album.coverImage, alt=album.title)
                .col-8
                  h4= album.title
                  p.rating.text-warning
                    each star in [1, 2, 3, 4, 5]
                      if star <= review.rating
                        i.fa-solid.fa-star
                      else
                        i.fa-regular.fa-star
                  p= album.artist
                  p= review.reviewText
                  a.btn.btn-primary.btn-green.float-end(href=album.spotifyUrl) Listen on Spotify
                  small.reviewTimestamp= review.createdOn
      else
        p No reviews yet.
