extends layout
block content
  .auth-page
    .auth-header
      h1 Register
    form.auth-form(action="/register", method="post", role="form")
      .form-field
        label.field-label(for="email") Email
        input#email.form-control(type="email", name="email", required)
      .form-field
        label.field-label(for="password") Password
        input#password.form-control(type="password", name="password", required)
      .form-field
        label.field-label(for="confirm") Password Confirm
        input#confirm.form-control(type="password", name="confirm", required)
      button.auth-button.btn.btn-primary(type="submit") Register
    p.auth-switch
      a(href="/login") Have an account? Log in!