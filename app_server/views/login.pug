extends layout
block content
  .auth-page
    .auth-header
      h1 Login
    form.auth-form(action="/login", method="post", role="form")
      .form-field
        label.field-label(for="email") Email
        input#email.form-control(type="email", name="email", required)
      .form-field
        label.field-label(for="password") Password
        input#password.form-control(type="password", name="password", required)
      button.auth-button.btn.btn-primary.btn-green(type="submit") Log in
    p.auth-switch
      a(href="/register") Don't have an account? Sign up!